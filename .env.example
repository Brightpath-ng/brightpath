# Local development environment only.
# Copy to .env.local (git-ignored) and fill in values from your LOCAL Supabase/Clerk/Paystack
# instances. Never put production credentials here or in .env.local — see
# docs/claude/environments.md.

# --- Database (local Supabase instance via `supabase start`, or a Supabase branch) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# --- Supabase (local project, from `supabase status`) ---
NEXT_PUBLIC_SUPABASE_URL="http://localhost:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Clerk (development instance keys — never the production instance) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# --- Paystack (test mode keys only) ---
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""

# --- apps/api ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
PORT=4000
# Allowed CORS origins — the deployed marketing/web URLs in production, localhost in dev.
MARKETING_ORIGIN="http://localhost:3000"
WEB_ORIGIN="http://localhost:3001"
