# Local development environment only.
# Copy to .env.local (git-ignored) and fill in values from your LOCAL Supabase/Clerk/Paystack
# instances. Never put production credentials here or in .env.local — see
# docs/claude/environments.md.

# --- Database (local Supabase instance via `supabase start`, or a Supabase branch) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# --- Supabase (local project, from `supabase status`) ---
NEXT_PUBLIC_SUPABASE_URL="http://localhost:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Clerk (development instance keys — never the production instance) ---
# One-time manual step, not an env var: apps/web/src/middleware.ts reads
# sessionClaims.publicMetadata.role to gate routes, but Clerk's session token
# does NOT include custom publicMetadata by default -- go to the Clerk dashboard
# > Configure > Sessions > Customize session token, and add:
#   { "publicMetadata": "{{user.public_metadata}}" }
# Without this, every signed-in user's role reads as undefined and everyone
# lands on /pending regardless of what's actually stored on their Clerk user.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Signing secret for the user.created webhook (apps/api/src/features/auth). Create the
# webhook endpoint in the Clerk dashboard (Configure > Webhooks) once you have a URL
# that can reach apps/api -- a tunnel (e.g. ngrok) for local dev, the deployed URL in
# prod -- then copy the signing secret it gives you here.
CLERK_WEBHOOK_SECRET=""
# Tells Clerk our app has its own custom auth pages (apps/web/src/app/(auth)/...)
# instead of Clerk's hosted Account Portal -- without these, redirectToSignIn()
# and friends send users to https://<instance>.accounts.dev instead of /sign-in.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
# apps/web's own origin -- apps/marketing links out to it (separate deployed app,
# separate domain) rather than using a relative /sign-in path that would 404.
NEXT_PUBLIC_WEB_APP_URL="http://localhost:3001"

# --- Admin bootstrap (apps/api/src/scripts/seed-admin.ts) ---
# Admins are never self-serve (blueprint §7.4) -- this script creates exactly one
# Clerk user + DB row with the admin role. Dev-instance only, same rule as every
# other Clerk var above: never run this script against production from a local
# machine. Use the existing "+clerk_test" dev bypass (e.g. you+admin@yourdomain.com)
# to sign in with the fixed OTP 424242 instead of a real email.
ADMIN_SEED_EMAIL=""
ADMIN_SEED_NAME="BrightPath Admin"

# --- Paystack (test mode keys only) ---
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""

# --- apps/api ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
PORT=4000
# Allowed CORS origins — the deployed marketing/web URLs in production, localhost in dev.
MARKETING_ORIGIN="http://localhost:3000"
WEB_ORIGIN="http://localhost:3001"
