// Single schema for the whole product, organized into commented sections that mirror
// apps/api/src/features/* as each feature adds its models (see docs/claude/architecture.md).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

// ── auth ──────────────────────────────────────────────────────────────────
// Multi-tenant-ready from day one (architecture.md, blueprint §8.1) --
// individual parents/tutors default to a single "BrightPath Direct" tenant
// row, so a future school/corporate tenant is a new row, not a schema change.
model Tenant {
  id        String     @id @default(cuid())
  name      String     @unique
  type      TenantType @default(direct)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  users User[]

  @@map("tenants")
}

enum TenantType {
  direct
  school
  corporate
}

// Table-driven RBAC, not a hardcoded enum (architecture.md, blueprint §8.1) --
// a future role (School Coordinator, Franchise Manager) is a new row, not a
// code change. The four Phase 1 roles are seeded in src/seed.ts.
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String[] @default([])

  users User[]

  @@map("roles")
}

// One row per Clerk identity. Role is resolved from here and mirrored into
// Clerk's publicMetadata by the API on creation, so apps/web's middleware can
// gate routes without a DB round trip on every request (architecture.md).
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  tenantId  String
  roleId    String
  name      String
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  role            Role             @relation(fields: [roleId], references: [id])
  tutorProfile    TutorProfile?
  studentProfiles StudentProfile[]

  @@index([tenantId])
  @@index([roleId])
  @@map("users")
}

// ── tutors ────────────────────────────────────────────────────────────────
// A tutor applicant's Clerk user + this row are created together server-side
// at application time (apps/api/src/features/tutors), not via self-serve
// sign-up -- see that feature's service.ts for why. status is deliberately
// PENDING/APPROVED/REJECTED rather than the blueprint's full 4-tier
// verification_tier enum (Section 11.1): tiers don't correspond to any real
// logic until the ID-verification/reference-checking follow-up slices exist.
model TutorProfile {
  id             String                 @id @default(cuid())
  userId         String                 @unique
  subjects       String[]
  qualifications String
  bio            String?
  status         TutorApplicationStatus @default(PENDING)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([status])
  @@map("tutor_profiles")
}

enum TutorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── students ──────────────────────────────────────────────────────────────
// A child is a profile the parent manages on their own account, not a
// separate Clerk login (blueprint §7.2, §14: "RBAC from day one, even with
// only 3 roles active") -- the `student` role and its dashboard route exist
// but stay unused in Phase 1. learningTrack defaults to tutor_led and isn't
// parent-selectable yet: real track routing is driven by the baseline
// assessment (blueprint §7.1), which doesn't exist yet -- storing the field
// now (per §6.4's explicit instruction) avoids a schema change later without
// building assessment logic that has nothing real to compute yet.
model StudentProfile {
  id                 String        @id @default(cuid())
  parentId           String
  name               String
  school             String?
  class              String?
  learningGoals      String?
  learningChallenges String?
  learningTrack      LearningTrack @default(tutor_led)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  parent User @relation(fields: [parentId], references: [id])

  @@index([parentId])
  @@map("student_profiles")
}

enum LearningTrack {
  tutor_led
  hybrid
  self_directed
}
